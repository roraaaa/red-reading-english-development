rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each reader can only see and change their own profile and scores.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // A saved score can never be edited, so a low score cannot be turned
      // into a high one after the fact.
      //
      // Deleting is allowed, because "Delete my account" has to be able to
      // remove every score the account saved. The app only ever deletes them
      // all at once; someone using the Firestore SDK directly could delete a
      // single score to tidy up their history. Closing that gap needs a Cloud
      // Function (Blaze plan) that deletes the data server-side when the
      // account goes.
      match /attempts/{attemptId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }
    }

    // Reading content. Signed-in readers can read it; nobody can change it
    // from the app. tool/upload_content.dart publishes it with a service
    // account, which is not limited by these rules.
    match /content/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /levels/{levelId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /passages/{passageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
