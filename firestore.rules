rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each child can only read and write their own profile and scores.
    // Saved attempts cannot be edited or deleted from the app, so scores
    // cannot be changed after the fact.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /attempts/{attemptId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    // Reading content. Signed-in readers can read it; nobody can change it
    // from the app. tool/upload_content.dart publishes it with a service
    // account, which is not limited by these rules.
    match /content/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /levels/{levelId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /passages/{passageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
